name: dome-lab

topology:
  kinds:
    nokia_srlinux:
      image: ghcr.io/nokia/srlinux:23.10.1

  nodes:
    ce1:
      kind: nokia_srlinux
      type: ixrd2
    pe1:
      kind: nokia_srlinux
      type: ixrd2
    p1:
      kind: nokia_srlinux
      type: ixrd3
    ce2:
      kind: nokia_srlinux
      type: ixrd2
    pe2:
      kind: nokia_srlinux
      type: ixrd2
    p2:
      kind: nokia_srlinux
      type: ixrd3

  links:
    # Inter P Routers
    - endpoints: ["p1:e1-1", "p2:e1-1"]
    # Lan 1
    - endpoints: ["p1:e1-2", "pe1:e1-2"]
    - endpoints: ["pe1:e1-1", "ce1:e1-1"]
    # lan2
    - endpoints: ["p2:e1-2", "pe2:e1-2"]
    - endpoints: ["pe2:e1-1", "ce2:e1-1"]
