{
    "name": "ContainerLab DevContainer",
    "build": {
        "dockerfile": "./dockerfile"
    },
    "runArgs": [
        "--privileged",  // Required for Container Lab to function properly
        "-v", "/var/run/docker.sock:/var/run/docker.sock"  // Share the Docker socket
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",  // Python extension (if needed)
                "ms-azuretools.vscode-docker"  // Docker extension
            ]
        }
    },
    "postCreateCommand": "containerlab version"  // Verify Container Lab installation
}